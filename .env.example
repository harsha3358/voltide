# Optional: ship sessions unlocked in this build (comma-separated numbers), e.g. 1,2
# On Vercel: Project → Settings → Environment Variables → VITE_UNLOCKED_SESSIONS
VITE_UNLOCKED_SESSIONS=

# Google Sheets accounts + tracking (see google-sheets/README.md).
# The deployed Apps Script URL is already built into src/lib/backend.js.
# Leave this empty to use it, set another /exec URL to use a different
# deployment, or set it to "off" to run with no login.
VITE_SHEETS_API=
