# Optional: ship sessions unlocked in this build (comma-separated numbers), e.g. 1,2
# On Vercel: Project → Settings → Environment Variables → VITE_UNLOCKED_SESSIONS
VITE_UNLOCKED_SESSIONS=

# Optional: Google Apps Script web app URL (see google-sheets/README.md).
# When set, students sign up / log in and their activity goes to the Google Sheet.
# On Vercel: Project → Settings → Environment Variables → VITE_SHEETS_API, then redeploy.
VITE_SHEETS_API=
